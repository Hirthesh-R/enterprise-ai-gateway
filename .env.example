# Copy to .env and adjust. NEVER commit .env.
# SQLite (default, no Docker needed):
DATABASE_URL=sqlite:///./data/gateway.db
# MySQL example: mysql+aiomysql://gateway:<password>@localhost:3306/gateway
# Leave empty to use the in-memory rate limiter fallback.
REDIS_URL=redis://localhost:6379/0
# HMAC secret for API-key hashing (min 16 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_SECRET=change-me-to-a-long-random-string
# development | test | production (production refuses the insecure default secret and hides error details)
ENVIRONMENT=development
RATE_LIMIT_TOKENS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Optional
LOG_LEVEL=INFO
AUTO_SEED_DEMO_DATA=true
DEMO_TRANSACTION_COUNT=80
INJECTION_BLOCK_THRESHOLD=MEDIUM
MOCK_LATENCY_SCALE=1.0
